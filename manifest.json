{
  "manifest_version": 3,
  "name": "FS PBX Click to Dial",
  "version": "1.0.8",
  "description": "Send selected phone numbers and phone links to your FS PBX desk phone.",
  "minimum_chrome_version": "127",
  "permissions": ["storage", "contextMenus", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "FS PBX Click to Dial", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
}
